{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["build", "image", "service", "scalePolicy", "persistence", "resources"],
  "properties": {
    "deploy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "build": {
      "type": "object",
      "required": ["git"],
      "properties": {
        "git": {
          "type": "object",
          "required": ["uri", "ref", "sourceSecret"],
          "properties": {
            "uri": {"type": "string", "minLength": 1},
            "ref": {"type": "string", "minLength": 1},
            "sourceSecret": {"type": "string", "minLength": 1}
          }
        },
        "sourceSecret": {
          "type": "object",
          "properties": {
            "create": {"type": "boolean"},
            "username": {"type": "string", "minLength": 1},
            "token": {"type": "string"}
          }
        }
      }
    },
    "podEnv": {
      "type": "object",
      "required": ["TZ", "LOG_LEVEL"],
      "properties": {
        "TZ": {"type": "string", "minLength": 1},
        "LOG_LEVEL": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL", "OFF"]
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "mountPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    },
    "route": {
      "type": "object",
      "required": ["enabled", "host", "termination", "insecureEdgeTerminationPolicy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "termination": {"type": "string", "enum": ["edge", "passthrough", "reencrypt"]},
        "insecureEdgeTerminationPolicy": {"type": "string", "enum": ["Allow", "Disable", "Redirect"]}
      }
    },
    "scalePolicy": {
      "type": "object",
      "required": ["enabled", "maxReplicas"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxReplicas": {
          "type": "integer",
          "const": 1,
          "description": "This workload must run with exactly one replica."
        }
      }
    },
    "resources": {"type": "object"}
  }
}
