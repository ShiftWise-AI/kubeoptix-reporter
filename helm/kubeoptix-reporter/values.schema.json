{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["build", "image", "service", "scalePolicy", "persistence", "resources"],
  "properties": {
    "deploy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "build": {
      "type": "object",
      "required": ["git"],
      "properties": {
        "git": {
          "type": "object",
          "required": ["uri", "ref", "sourceSecret"],
          "properties": {
            "uri": {"type": "string", "minLength": 1},
            "ref": {"type": "string", "minLength": 1},
            "sourceSecret": {"type": "string", "minLength": 1}
          }
        },
        "sourceSecret": {
          "type": "object",
          "properties": {
            "create": {"type": "boolean"},
            "username": {"type": "string", "minLength": 1},
            "token": {"type": "string"}
          }
        }
      }
    },
    "podEnv": {
      "type": "object",
      "required": ["TZ", "LOG_LEVEL"],
      "properties": {
        "TZ": {"type": "string", "minLength": 1},
        "LOG_LEVEL": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL", "OFF"]
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["api"],
      "properties": {
        "api": {
          "type": "object",
          "required": ["enabled", "name", "type", "port", "targetPort"],
          "properties": {
            "enabled": {"type": "boolean"},
            "name": {"type": "string", "minLength": 1},
            "type": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "mountPath", "reportsPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"},
        "reportsPath": {"type": "string", "pattern": "^/"}
      }
    },
    "scalePolicy": {
      "type": "object",
      "required": ["enabled", "maxReplicas"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxReplicas": {
          "type": "integer",
          "const": 1,
          "description": "This workload must run with exactly one replica."
        }
      }
    },
    "resources": {"type": "object"}
  }
}
